# --- This service -----------------------------------------------------------
# Address to listen on. Keep it on loopback; nginx is the only thing that should reach it.
VWSYNC_LISTEN=127.0.0.1:8080

# The single API user. Create the hash with: vwsync-api hash-password
# Single quotes matter: the hash contains $ characters.
VWSYNC_USER=sync
VWSYNC_PASSWORD_HASH='$2a$12$replace-me'

# Signs the login tokens. At least 32 characters, random. Create one with: openssl rand -base64 48
VWSYNC_JWT_SECRET=

# Optional. Token lifetime (1m to 24h, default 15m).
#VWSYNC_TOKEN_TTL=15m

# Set to true only behind nginx on the same host with "proxy_set_header X-Real-IP $remote_addr".
# The header is only believed for requests from 127.0.0.1 or ::1.
# Used so the login rate limit sees the real client, not the proxy.
VWSYNC_TRUST_PROXY=true

# Optional. Log level: debug, info (default), warn, error. debug also logs every call to Vaultwarden.
#VWSYNC_LOG_LEVEL=info
# Optional. Log format: text (default) or json.
#VWSYNC_LOG_FORMAT=text

# --- Vaultwarden ------------------------------------------------------------
# Personal API key of an owner/admin account (web vault: Account settings, Security, View API key).
VW_URL=https://vault.example.com
VW_CLIENT_ID=user.00000000-0000-0000-0000-000000000000
VW_CLIENT_SECRET=

# Only needed for POST /v1/confirm. Without it everything else works.
VW_MASTER_PASSWORD=
