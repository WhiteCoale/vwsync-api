# --- This service -----------------------------------------------------------
# Address to listen on. Keep it on loopback; nginx is the only thing that should reach it.
VWSYNC_LISTEN=127.0.0.1:8080

# Hash of the access key that callers present as "Authorization: Bearer <key>".
# Create the key and this line with: vwsync-api generate-key
# Several hashes may be listed, separated by commas. All of them are valid, which lets you replace
# a key without downtime.
VWSYNC_API_KEY_HASH=

# Set to true only behind nginx on the same host with "proxy_set_header X-Real-IP $remote_addr".
# The header is only believed for requests from 127.0.0.1 or ::1. It gives the log the real address
# of a caller whose request was rejected, instead of the address of nginx.
VWSYNC_TRUST_PROXY=true

# Optional. Log file. Under systemd the unit creates /var/log/vwsync-api for the service, and only
# that directory is writable. Without it the log goes to stderr, under systemd into the journal.
# "systemctl reload vwsync-api" reopens the file, the logrotate template uses that.
VWSYNC_LOG_FILE=/var/log/vwsync-api/vwsync-api.log

# Optional. Log level: debug, info (default), warn, error. debug also logs every call to Vaultwarden.
#VWSYNC_LOG_LEVEL=info
# Optional. Log format: text (default) or json.
#VWSYNC_LOG_FORMAT=text

# --- Vaultwarden ------------------------------------------------------------
# Personal API key of an owner/admin account (web vault: Account settings, Security, View API key).
# This belongs to the service. It is not the access key of the callers.
# VW_URL must use https, except for localhost.
VW_URL=https://vault.example.com
VW_CLIENT_ID=user.00000000-0000-0000-0000-000000000000
VW_CLIENT_SECRET=

# Optional. PEM file with extra certificate authorities to trust for VW_URL, for a Vaultwarden
# server whose certificate comes from an internal CA.
#VW_CA_FILE=/etc/vwsync-api/vaultwarden-ca.pem

# Only needed for POST /v1/confirm and for creating organizations. Without it everything else works.
VW_MASTER_PASSWORD=
